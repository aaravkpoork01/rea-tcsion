# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8417

# ---- storage ---------------------------------------------------------------
# Two modes, chosen by DATABASE_URL:
#
#   DATABASE_URL unset → local SQLite file at DATA_DIR/DB_FILE
#   DATABASE_URL set   → Postgres/Neon, e.g.
#                        postgresql://user:password@host/db?sslmode=require
#
# A local .env is loaded automatically at startup. On Vercel, set variables in
# the project dashboard instead (the deployment filesystem is read-only except
# /tmp, so a SQLite file there does not survive a cold start).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATA_DIR=./data
DB_FILE=ion.db

# ---- static roots ----------------------------------------------------------
MIRROR_DIR=./public
ADMIN_UI_DIR=./public/admin

# ---- sessions (seconds) ----------------------------------------------------
CANDIDATE_SESSION_TTL=43200
ADMIN_SESSION_TTL=604800

# ---- bootstrap seed --------------------------------------------------------
SEED_ORG_ID=726
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123
SEED_CANDIDATE_LOGIN=11111
SEED_CANDIDATE_PASSWORD=Guest

# ---- limits ----------------------------------------------------------------
MAX_REQUEST_BYTES=8388608
MAX_AUDIT_ENTRIES=200
MAX_ANSWER_BYTES=200000

# ---- behaviour -------------------------------------------------------------
SEED_ON_START=true
LOG_LEVEL=info
