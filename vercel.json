{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{src,config,public,raw}/**",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/OnlineAssessment/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/OnlineAssessment",
      "destination": "/index.html"
    },
    {
      "source": "/IBA/:path*",
      "destination": "/api?_prefix=IBA&path=:path*"
    },
    {
      "source": "/IBACC/:path*",
      "destination": "/api?_prefix=IBACC&path=:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api?_prefix=api/admin&path=:path*"
    },
    {
      "source": "/api/config",
      "destination": "/api?_prefix=api&path=config"
    },
    {
      "source": "/tools/:path*",
      "destination": "/api?_prefix=tools&path=:path*"
    }
  ]
}
